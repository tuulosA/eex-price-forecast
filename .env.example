# Copy to .env.local and fill in. Only ENTSO_E_API_KEY is required.

# ENTSO-E Transparency Platform security token (https://transparency.entsoe.eu/ -> My Account).
ENTSO_E_API_KEY=your_entsoe_token

# Optional: Open-Meteo customer API key. If unset, the free public API is used.
OPENMETEO_API_KEY=

# Optional overrides (sensible defaults are used otherwise).
# DB_PATH=data/eex.db
