# Environment
.venv/
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data, models, generated artifacts (SQLite db, models, CSVs, geo cache) are regenerated by the
# pipeline and never committed...
data/**
# ...except the generated PNG visuals (forecast plots + analysis maps), kept as example images, plus the
# directory placeholder. Re-include every subdirectory so git descends; non-PNG artifacts stay ignored.
!data/**/
!data/**/*.png
!data/.gitkeep
# ...and the small text reports that are the empirical paper trail behind committed configs/decisions:
# the frozen-cutoff benchmark, tuning provenance for hyperparams.json, the aggregation/ablation A/Bs, the
# point rankings behind weather_points.json, and the correlation matrix. (geo/models/forecast stay out.)
!data/evaluation/*.json
!data/tuning/*.json
!data/aggregation/*.json
!data/ablation/*.json
!data/rank/*.csv
!data/analysis/correlation.csv

# OS / editor
.DS_Store
.idea/
.vscode/

# Timestamped per-run CLI logs (see eex_forecast.logging_setup)
logs/
