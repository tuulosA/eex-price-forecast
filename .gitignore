# Environment
.venv/
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data, models, generated artifacts (SQLite db, models, CSVs, geo cache) are regenerated by the
# pipeline and never committed...
data/**
# ...except the generated PNG visuals (forecast plots + analysis maps), kept as example images, plus the
# directory placeholder. Re-include every subdirectory so git descends; non-PNG artifacts stay ignored.
!data/**/
!data/**/*.png
!data/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Timestamped per-run CLI logs (see eex_forecast.logging_setup)
logs/
