# Environment
.venv/
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.tmp_pytest*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data, models, generated artifacts (SQLite db, models, CSVs, geo cache) are regenerated by the
# pipeline and never committed...
data/**
# ...except the generated PNG visuals (forecast plots + analysis maps), kept as example images, plus the
# directory placeholder. Re-include every subdirectory so git descends; non-PNG artifacts stay ignored.
!data/**/
!data/**/*.png
!data/.gitkeep
# ...and the small text reports that are the empirical paper trail behind committed configs/decisions:
# the frozen-cutoff benchmark, tuning provenance for hyperparams.json, the aggregation/ablation A/Bs, the
# point rankings behind weather_points.json, correlation matrix, and model diagnostics.
# (geo/models/forecast stay out.)
!data/evaluation/*.json
!data/tuning/*.json
!data/aggregation/*.json
!data/ablation/*.json
!data/analysis/*_experiment.json
!data/analysis/correlation_*.csv
!data/analysis/quarter_validation.json
!data/rank/*.csv
# the bidding-zone candidate grids (`eex points grid`)
!data/candidates/grid_*.csv
!data/analysis/solar_error_slices.json
!data/history/pre_nn_20261015/**/*.json
!data/history/hourly_20261016/ablation/*.json
!data/history/hourly_20261016/aggregation/*.json
!data/history/hourly_20261016/analysis/*.json
!data/history/hourly_20261016/analysis/correlation_*.csv
!data/history/hourly_20261016/config/*.json
!data/history/hourly_20261016/evaluation/*.json
!data/history/hourly_20261016/tuning/*.json
# Fitted models and local research tools stay local, including in archived directories.
data/history/**/models/
data/**/local_tools/
data/pytest_tmp/

# OS / editor
.DS_Store
.idea/
.vscode/

# Timestamped per-run CLI logs (see eex_forecast.logging_setup)
logs/

# Local analysis notebooks
notebooks/

